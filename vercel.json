{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/a/:slug",
      "destination": "/agent"
    },
    {
      "source": "/e/:token",
      "destination": "/agent-edit"
    },
    {
      "source": "/d/:slug",
      "destination": "/scenario-desk"
    },
    {
      "source": "/p/:slug",
      "destination": "/partner"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?grahamfinancial\\.us"
        }
      ],
      "destination": "/home"
    }
  ]
}
